# Copy to .env.local and fill in for local development.
# CI builds read these from GitHub Actions secrets of the same name.

# The CLIENT ID of the GitHub App you registered for gition.
VITE_GITHUB_CLIENT_ID=

# The deployed gition auth Worker URL (no trailing slash), e.g.
# https://gition-auth.example.workers.dev
VITE_AUTH_WORKER_URL=
